#!/bin/sh
# `srt` passes `--new-session`, which breaks job control, resize and Ctrl-C; only safe to drop without TIOCSTI.
if [ "$(cat /proc/sys/dev/tty/legacy_tiocsti 2>/dev/null)" = 0 ]; then
    for arg; do
        shift
        [ "$arg" = --new-session ] || set -- "$@" "$arg"
    done
fi
exec /usr/bin/bwrap "$@"
